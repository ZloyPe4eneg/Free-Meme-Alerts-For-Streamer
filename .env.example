# Пример настроек. Скопируйте в .env и запускайте: node --env-file=.env server.js
# Сам файл .env в репозиторий не попадает (см. .gitignore).

# Порт сервера
PORT=3000

# Секрет, из которого выводятся ключи каналов. Задайте длинную случайную строку.
# Если не задан, сервер сам создаст его в data/secret.txt.
SERVER_SECRET=

# Поставьте 1, если сервер стоит за прокси хостинга (Render, nginx и т.п.)
TRUST_PROXY=0
